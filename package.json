{
  "name": "muk-require",
  "description": "Mock dependencies.",
  "keywords": [
    "test",
    "mock",
    "dependency"
  ],
  "version": "1.2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/fent/node-muk-require.git"
  },
  "author": "fent <fentbox@gmail.com> (https://github.com/fent)",
  "main": "./dist/index.js",
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "nyc --extension .ts --reporter=lcov --reporter=text-summary npm run test:unit",
    "test:unit": "mocha --require ts-node/register test/*-test.ts"
  },
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "@types/node": "^17.0.23",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.3"
  },
  "engines": {
    "node": ">=6"
  },
  "license": "MIT",
  "files": [
    "dist"
  ]
}
